# Optional alternatives to the local connection form. Do not commit real values.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_REGISTRAR_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
RESEND_API_KEY=
# Optional customer-owned Google Desktop OAuth client. Consent happens in Growth.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional customer-owned Bing Webmaster API key (account-wide access).
BING_WEBMASTER_API_KEY=
# Optional mastodon.social user token: read:accounts read:statuses write:statuses.
MASTODON_ACCESS_TOKEN=
# Optional 64-hex-character management seed from your secret store (required for cloud monitoring on non-Windows).
LAUNCHKIT_MONITORING_KEY=
# Node does not automatically load this file; use your OS environment or the UI.
# LAUNCHKIT_DATA_DIR must be outside your repositories.
